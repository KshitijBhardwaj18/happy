# Copy to .env for local runs. On AgentCore Runtime these come from agentcore.json envVars,
# and the two tokens come from AgentCore Identity credential providers instead.
AWS_REGION=us-east-1
HAPPY_MODEL_ORCHESTRATOR=us.anthropic.claude-sonnet-5
HAPPY_MODEL_SPECIALIST=us.anthropic.claude-haiku-4-5-20251001-v1:0
KUBECONFIG_B64=                # base64 of ~/.kube/happy.yaml (infra/ec2-k3s/fetch-kubeconfig.sh fills this)
SLACK_BOT_TOKEN=               # xoxb-... (never committed; on Runtime via Identity provider "slack-bot-token")
SLACK_CHANNEL_ID=              # C0... for #happy-oncall
GITHUB_TOKEN=                  # fine-grained PAT, contents+pull-requests read/write on the repo
GITHUB_REPO=KshitijBhardwaj18/happy
MEMORY_HAPPYMEMORY_ID=         # set by agentcore deploy on Runtime; leave blank locally to use the file ledger
HAPPY_GATEWAY_URL=             # set after agentcore deploy; blank = call cluster write tools directly
HAPPY_ACTOR_ID=sre-team
