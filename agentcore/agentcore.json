{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "happy",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "happy"
  },
  "runtimes": [
    {
      "name": "happy",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/happy/",
      "runtimeVersion": "PYTHON_3_12",
      "envVars": [
        {
          "name": "HAPPY_WATCH_NAMESPACES",
          "value": "[\"shop\"]"
        },
        {
          "name": "HAPPY_ACTOR_ID",
          "value": "sre-team"
        },
        {
          "name": "GITHUB_REPO",
          "value": "KshitijBhardwaj18/happy"
        },
        {
          "name": "HAPPY_GATEWAY_URL",
          "value": "https://happy-happyhands-uacr1x3qd2.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 1800,
        "maxLifetime": 7200
      }
    }
  ],
  "memories": [
    {
      "name": "happyMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "HappyQuality",
      "agent": "happy",
      "evaluators": [
        "Builtin.ToolSelectionAccuracy",
        "Builtin.Helpfulness"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [
    {
      "name": "HappyHands",
      "protocolType": "MCP",
      "description": "Happy's hands: cluster writes as governed MCP tools",
      "targets": [
        {
          "name": "Hands",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "rollout_restart",
              "description": "Restart every pod of a Kubernetes deployment by rolling it (kubectl rollout restart). SAFE tier: fixes stuck or crash-looping pods without changing configuration.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Deployment name"
                  },
                  "namespace": {
                    "type": "string",
                    "description": "Namespace, default shop"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "name": "scale_deployment",
              "description": "Set the replica count of a deployment. SAFE up to 5 replicas; policy forbids larger values.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "replicas": {
                    "type": "integer",
                    "description": "Desired replicas"
                  },
                  "namespace": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "replicas"
                ]
              }
            },
            {
              "name": "rollback_deployment",
              "description": "Roll a deployment back to its previous revision (or a given revision). APPROVAL tier: only call after a human approved it.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "integer",
                    "description": "Optional target revision; default previous"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "name": "set_image",
              "description": "Change the container image of a deployment. APPROVAL tier: only call after a human approved it.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "image"
                ]
              }
            },
            {
              "name": "delete_namespace",
              "description": "Delete an entire namespace and everything in it. FORBIDDEN: policy blocks this; it exists to prove the block.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string"
                  }
                },
                "required": [
                  "namespace"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "app/hands",
              "handler": "handler.handler"
            },
            "pythonVersion": "PYTHON_3_12",
            "timeout": 30,
            "memorySize": 256,
            "iamPolicy": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": "arn:aws:ssm:us-east-1:575751781540:parameter/happy/*"
                }
              ]
            }
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": false,
      "exceptionLevel": "DEBUG",
      "policyEngineConfiguration": {
        "policyEngineName": "HappyPolicy",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "HappyPolicy",
      "description": "Happy's trust ladder: forbid destructive tools, cap scaling",
      "policies": [
        {
          "name": "TrustLadder",
          "description": "Happy trust ladder: forbid delete_namespace, cap scale at 5, permit the rest",
          "statement": "// Happy's trust ladder, enforced by AgentCore Policy at the Gateway (not by the model).\n// Action names are \"<Target>___<tool>\"; the resource is the deployed gateway ARN,\n// substituted by scripts/render_policy.sh after the first deploy.\n\n// Never, no matter what the model decides.\nforbid(principal,\n  action == AgentCore::Action::\"Hands___delete_namespace\",\n  resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:575751781540:gateway/happy-happyhands-uacr1x3qd2\");\n\n// Scaling is safe only within a small band.\npermit(principal,\n  action == AgentCore::Action::\"Hands___scale_deployment\",\n  resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:575751781540:gateway/happy-happyhands-uacr1x3qd2\")\nwhen { context.input.replicas <= 5 };\n\n// Safe and approval-gated actions are allowed at the gateway; the approval gate itself\n// lives in the agent (a Strands interrupt that waits for a human reply in Slack).\npermit(principal,\n  action in [AgentCore::Action::\"Hands___rollout_restart\",\n             AgentCore::Action::\"Hands___rollback_deployment\",\n             AgentCore::Action::\"Hands___set_image\"],\n  resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:575751781540:gateway/happy-happyhands-uacr1x3qd2\");",
          "sourceFile": "policies/happy.rendered.cedar",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}